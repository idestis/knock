# Copy to .env (gitignored). Read by Taskfile.yml.
TEAM_ID=
NOTARY_PROFILE=knock-notary

# Local relay (task relay:run). Leave sign-in empty to run anonymous-only.
# Setting a provider makes sign-in required unless KNOCK_ALLOW_ANONYMOUS=true.
# See docs/RELAY_SIGN_IN.md.
KNOCK_PUBLIC_URL=http://127.0.0.1:8787
KNOCK_TOKEN_SECRET=
KNOCK_ALLOW_ANONYMOUS=
KNOCK_GOOGLE_CLIENT_ID=
KNOCK_GOOGLE_CLIENT_SECRET=
KNOCK_GOOGLE_DOMAIN=
KNOCK_GITHUB_CLIENT_ID=
KNOCK_GITHUB_CLIENT_SECRET=
KNOCK_GITHUB_ORG=
